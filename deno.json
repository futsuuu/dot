{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "tasks": {
    "install-arch": {
      "command": "deno run -A ./dist/arch_installer.js",
      "dependencies": ["bundle"]
    },
    "bundle": "deno bundle --frozen --outdir ./dist ./arch_installer.ts"
  },
  "imports": {
    "@david/dax": "jsr:@david/dax@^0.48.3",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  }
}
